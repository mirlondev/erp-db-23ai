page 1 (
    name: Home
    alias: HOME
    title: POS Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal-caissier
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region welcome-hero (
        name: Welcome
        type: staticContent
        source {
            htmlCode:
                ```html
                <h1 style="margin:0;font-size:24px;font-weight:600;">REGAL POS &mdash; Pointe-Noire</h1>
                <p style="margin:4px 0 0;font-size:14px;opacity:.9;">Session: &APP_USER. &mdash; <span id="todayDate"></span></p>
                <script>
                  document.getElementById('todayDate').innerText = new Date().toLocaleDateString('fr-FR', {weekday:'long', year:'numeric', month:'long', day:'numeric'});
                </script>
                ```
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                u-color-1
            ]
            icon: fa-cash-register
        }
    )

    region pos-kpis (
        name: POS KPIs
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select label, valeur as value, 'f?p='||:APP_ID||':8:'||:APP_SESSION as url
                  from v_top_kpi_dashboard
                 where label in ('CA jour','Tickets jour','Panier moyen','CA MTD')
                 order by decode(label,'CA jour',1,'Tickets jour',2,'Panier moyen',3,'CA MTD',4)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--hiddenOverflow
            ]
        }
        settings {
            value: VALUE
            bottomLabel: LABEL
            linkTarget: {
                type: url
                url: &URL.
            }
            layout: 4Columns
        }
    )

    region quick-actions (
        name: Quick actions
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:8px 0;">
                  <a href="f?p=&APP_ID.:20:&APP_SESSION." class="t-Button t-Button--large t-Button--primary" style="text-align:center;text-decoration:none;">
                    <span class="fa-bolt"></span>&nbsp;Quick Billing
                  </a>
                  <a href="f?p=&APP_ID.:10:&APP_SESSION." class="t-Button t-Button--large" style="text-align:center;text-decoration:none;">
                    <span class="fa-cash-register"></span>&nbsp;Sessions
                  </a>
                  <a href="f?p=&APP_ID.:12:&APP_SESSION." class="t-Button t-Button--large" style="text-align:center;text-decoration:none;">
                    <span class="fa-receipt"></span>&nbsp;Tickets
                  </a>
                  <a href="f?p=&APP_ID.:14:&APP_SESSION." class="t-Button t-Button--large t-Button--success" style="text-align:center;text-decoration:none;">
                    <span class="fa-money-bill"></span>&nbsp;Z de caisse
                  </a>
                </div>
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region recent-tickets (
        name: Recent tickets (today)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(ticket_date, 'HH24:MI:SS') as time,
                       ticket_no,
                       customer_code,
                       customer_name,
                       total_ht,
                       tax_amount_1 as tva,
                       total_ttc,
                       user_code,
                       case status when 'V' then 'Valid' when 'A' then 'Active' when 'C' then 'Cancelled' else status end as status
                  from app_sales.ticket
                 where trunc(ticket_date) = trunc(sysdate)
                 order by ticket_date desc
                 fetch first 20 rows only
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }

        column TIME (
            heading {
                heading: Time
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )

        column TICKET_NO (
            heading {
                heading: Ticket
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column CUSTOMER_CODE (
            heading {
                heading: Customer
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column CUSTOMER_NAME (
            heading {
                heading: Name
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column TOTAL_HT (
            heading {
                heading: HT (XAF)
                alignment: end
            }
            layout {
                sequence: 50
            }
            source {
                dataType: number
            }
        )

        column TVA (
            heading {
                heading: TVA
                alignment: end
            }
            layout {
                sequence: 60
            }
            source {
                dataType: number
            }
        )

        column TOTAL_TTC (
            heading {
                heading: TTC (XAF)
                alignment: end
            }
            layout {
                sequence: 70
            }
            source {
                dataType: number
            }
        )

        column USER_CODE (
            heading {
                heading: User
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column STATUS (
            heading {
                heading: Status
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )
    )
)