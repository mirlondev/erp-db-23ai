                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @THEORETICAL_BALANCE
                layout {
                    sequence: 12
                }
            )

            displayColumn (
                column: @ECART
                layout {
                    sequence: 13
                }
            )

            displayColumn (
                column: @NB_TICKETS
                layout {
                    sequence: 14
                }
            )

            displayColumn (
                column: @CA_HT
                layout {
                    sequence: 15
                }
            )

            displayColumn (
