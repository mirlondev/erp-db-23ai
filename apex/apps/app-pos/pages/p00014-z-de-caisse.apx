page 14 (
    name: Z de caisse
    alias: Z-DE-CAISSE
    title: Z de caisse
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorization: @regal-manager
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region z-de-caisse (
        name: Z de caisse
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                -- FIX audit 2026-10-03 (CRITIQUE — manipulation d'argent)
                -- Règle d'or : JAMAIS de NULL dans une colonne monétaire
                -- affichée à un utilisateur. NVL(col, 0) partout.
                -- L'écart est calculé TOUJOURS, jamais NULL.
                SELECT s.terminal_id, s.session_no, s.user_code,
                       t.terminal_name, t.warehouse_code,
                       TO_CHAR(s.opened_at, 'DD/MM/YYYY HH24:MI') AS opened,
                       TO_CHAR(s.closed_at, 'DD/MM/YYYY HH24:MI') AS closed,
                       CASE WHEN s.closed_at IS NULL THEN 'OUVERTE' ELSE 'FERMÉE' END AS status,
                       -- Balances protégées (NVL sur chaque colonne nullable)
                       NVL(s.opening_balance,    0) AS opening_balance,
                       NVL(s.closing_balance,    0) AS closing_balance,
                       NVL(s.theoretical_balance,0) AS theoretical_balance,
                       -- Écart JAMAIS NULL : NVL(closing,0) - NVL(theoretical,0)
                       NVL(s.closing_balance,    0) - NVL(s.theoretical_balance, 0) AS ecart,
                       -- Alerte automatique : > 100 XAF = suspect
                       CASE
                         WHEN s.closed_at IS NULL THEN '⚠️ Session non clôturée'
                         WHEN ABS(NVL(s.closing_balance,0) - NVL(s.theoretical_balance,0)) > 100
                           THEN '⚠️ ÉCART > 100 XAF'
                         ELSE 'OK'
                       END AS alerte,
                       (SELECT COUNT(*) FROM app_sales.ticket tk
                         WHERE tk.terminal_id = t.terminal_code
                           AND tk.session_no  = s.session_no) AS nb_tickets,
                       (SELECT NVL(SUM(total_ht), 0) FROM app_sales.ticket tk
                         WHERE tk.terminal_id = t.terminal_code
                           AND tk.session_no  = s.session_no) AS ca_ht,
                       (SELECT NVL(SUM(total_ttc), 0) FROM app_sales.ticket tk
                         WHERE tk.terminal_id = t.terminal_code
                           AND tk.session_no  = s.session_no) AS ca_ttc
                  FROM app_pos.pos_session s
                  JOIN app_pos.pos_terminal t ON t.terminal_id = s.terminal_id
                 WHERE s.terminal_id = :P40_TERMINAL_ID
                   AND s.session_no  = :P40_SESSION_NO
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        toolbar {
