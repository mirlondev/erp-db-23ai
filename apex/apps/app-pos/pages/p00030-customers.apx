page 30 (
    name: Customers
    alias: CUSTOMERS
    title: Clients — LITOKO SARL
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal_vendeur
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
        breadcrumb: @breadcrumb
    }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region customers-kpi (
        name: Indicateurs clients
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    pageItem P30_KPI_TOTAL (
        type: displayOnly
        label {
        label: Total clients
    }
        layout {
            sequence: 10
            region: @customers_kpi
            slot: regionBody
            column: 1
            startNewRow: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        source {
            type: expression
            plsqlExpression: to_char(app_api.apex_kpi_customer_count, 'FM999,999')
            used: always
        }
    )

    pageItem P30_KPI_BLOCKED (
        type: displayOnly
        label {
        label: Bloqués
    }
        layout {
            sequence: 20
            region: @customers_kpi
            slot: regionBody
            column: 2
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        source {
            type: expression
            plsqlExpression: to_char(app_api.apex_kpi_customer_blocked_count, 'FM999,999')
            used: always
        }
    )

    pageItem P30_KPI_NEW_MONTH (
        type: displayOnly
        label {
        label: Nouveaux ce mois
    }
        layout {
            sequence: 30
            region: @customers_kpi
            slot: regionBody
            column: 3
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        source {
            type: expression
            plsqlExpression: to_char(nvl((select count(*) from app_party.party where nature_id=1 and trunc(created_at,'MM')=trunc(sysdate,'MM')),0),'FM999,999')
            used: always
        }
    )

    region customers-list (
        name: Customer List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.party_code,
                       p.party_name,
                       p.city,
                       p.country,
                       p.phone,
                       p.email,
                       p.payment_terms,
                       p.credit_days,
                       case when p.is_blocked = 'Y'
                            then 'BLOQUÉ'
                            else 'OK'
                       end as status,
                       case when p.is_blocked = 'Y'
                            then '<span class="t-Badge t-Badge--danger">BLOQUÉ</span>'
                            else '<span class="t-Badge t-Badge--success">OK</span>'
                       end as status_badge
                  from app_party.party p
                 where p.nature_id = 1
                 order by p.party_name
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }

        column PARTY_CODE (
            type: plainText
            heading {
        heading: Code
    }
            layout {
        sequence: 10
    }
            source {
        dataType: STRING
    }
        )

        column PARTY_NAME (
            type: plainText
            heading {
        heading: Nom
    }
            layout {
        sequence: 20
    }
            source {
        dataType: STRING
    }
        )

        column CITY (
            type: plainText
            heading {
        heading: Ville
    }
            layout {
        sequence: 30
    }
            source {
        dataType: STRING
    }
        )

        column COUNTRY (
            type: plainText
            heading {
        heading: Pays
    }
            layout {
        sequence: 40
    }
            source {
        dataType: STRING
    }
        )

        column PHONE (
            type: plainText
            heading {
        heading: Téléphone
    }
            layout {
        sequence: 50
    }
            source {
        dataType: STRING
    }
        )

        column EMAIL (
            type: plainText
            heading {
        heading: Email
    }
            layout {
        sequence: 60
    }
            source {
        dataType: STRING
    }
        )

        column PAYMENT_TERMS (
            type: plainText
            heading {
        heading: Conditions
    }
            layout {
        sequence: 70
    }
            source {
        dataType: STRING
    }
        )

        column CREDIT_DAYS (
            type: plainText
            heading {
        heading: Jours crédit
        alignment: end
    }
            layout {
        sequence: 80
    }
            source {
        dataType: STRING
    }
        )

        column STATUS (
            type: plainText
            heading {
        heading: Statut (raw)
    }
            layout {
        sequence: 85
    }
            source {
        dataType: STRING
    }
            filter {
                isSortable: true
                isSearchable: true
                isBreakable: true
            }
        )

        column STATUS_BADGE (
            type: plainText
            heading {
        heading: Statut
    }
            layout {
        sequence: 90
    }
            source {
        dataType: STRING
    }
            appearance {
        htmlExpression: #STATUS_BADGE#
    }
        )

        savedReport default-customers (
            visibility: primaryDefault
            view {
                rowsPerPage: 25
            }
        )
    )

)
