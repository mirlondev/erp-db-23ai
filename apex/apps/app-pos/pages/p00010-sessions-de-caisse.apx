                heading: Status
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 7
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
