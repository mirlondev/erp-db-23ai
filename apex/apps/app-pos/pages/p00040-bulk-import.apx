page 40 (
    name: Bulk Import
    alias: BULK_IMPORT
    title: Import en masse — POS
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal_manager
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
        breadcrumb: @breadcrumb
    }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region import-steps (
        name: Étapes import
        type: staticContent
        source {
        htmlCode: <div class="t-Wizard-steps"><div class="t-Wizard-step is-active"><span class="t-Wizard-stepNumber">1</span><span class="t-Wizard-stepLabel">Choisir le type</span></div><div class="t-Wizard-step"><span class="t-Wizard-stepNumber">2</span><span class="t-Wizard-stepLabel">Uploader le CSV</span></div><div class="t-Wizard-step"><span class="t-Wizard-stepNumber">3</span><span class="t-Wizard-stepLabel">Résultats</span></div></div>
    }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    region help-text (
        name: Comment importer ?
        type: staticContent
        source {
        htmlCode: <p><strong>Format CSV attendu selon le type :</strong></p><table class="t-Report-report"><thead><tr><th>Type</th><th>Colonnes requises</th><th>Exemple</th></tr></thead><tbody><tr><td>PRODUCTS</td><td>codart, libart, tarifstd</td><td>ART001,Bière 65cl,1500</td></tr><tr><td>CUSTOMERS</td><td>codtie, nomtie, adrtie1</td><td>CLI001,Jean Mbemba,Pointe-Noire</td></tr></tbody></table><p>Encodage UTF-8, séparateur virgule, max 50 Mo.</p>
    }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    region upload-region (
        name: Upload CSV
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P40_DATA_TYPE (
        type: selectList
        label {
        label: Type de données
        alignment: left
    }
        lov {
            type: staticValues
            staticValues: PRODUCTS;Produits:CUSTOMERS;Clients
        }
        layout {
            sequence: 10
            region: @upload_region
            slot: regionBody
            alignment: left
            startNewRow: true
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: PRODUCTS
        }
        validation {
        valueRequired: true
    }
    )

    pageItem P40_CSV_FILE (
        type: fileUpload
        label {
        label: Fichier CSV
        alignment: left
    }
        display {
            displayAs: blockDropzone
            dropzoneDesc: Glisser-déposer le fichier CSV ici ou cliquer pour parcourir (max 50 Mo)
        }
        storage {
            type: appTempFiles
            maxFileSize: 50000
        }
        layout {
            sequence: 20
            region: @upload_region
            slot: regionBody
            alignment: left
            startNewRow: true
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 64
        }
        validation {
        valueRequired: true
    }
    )

    button import_csv (
        buttonName: IMPORT
        label: Importer le CSV
        layout {
            sequence: 30
            region: @upload_region
            slot: regionBody
            startNewRow: true
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
            hot: true
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    region import-result (
        name: Résultats du dernier import
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select etl_id,
                       source_table,
                       target_table,
                       rows_processed,
                       status,
                       case when status = 'OK'    then '<span class="t-Badge t-Badge--success">OK</span>'
                            when status = 'ERROR' then '<span class="t-Badge t-Badge--danger">ERREUR</span>'
                            else '<span class="t-Badge t-Badge--neutral">' || status || '</span>'
                       end as status_badge,
                       to_char(started_at, 'DD/MM/YYYY HH24:MI:SS') as started_at,
                       substr(error_message, 1, 200) as error
                  from app_api.etl_run_progress
                 where started_at >= trunc(sysdate)
                 order by started_at desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }

        column ETL_ID (
            heading {
        heading: ETL ID
    }
            layout {
        sequence: 10
    }
            source {
        
    }
        )

        column SOURCE_TABLE (
            heading {
        heading: Source
    }
            layout {
        sequence: 20
    }
            source {
        
    }
        )

        column TARGET_TABLE (
            heading {
        heading: Cible
    }
            layout {
        sequence: 30
    }
            source {
        
    }
        )

        column ROWS_PROCESSED (
            heading {
        heading: Lignes
        alignment: end
    }
            layout {
        sequence: 40
    }
            source {
        
    }
        )

        column STATUS (
            heading {
        heading: Statut (raw)
    }
            layout {
        sequence: 45
    }
            source {
        
    }
        )

        column STATUS_BADGE (
            heading {
        heading: Statut
    }
            layout {
        sequence: 50
    }
            source {
        
    }
            appearance {
        htmlExpression: #STATUS_BADGE#
    }
        )

        column STARTED_AT (
            heading {
        heading: Démarré
    }
            layout {
        sequence: 60
    }
            source {
        
    }
        )

        column ERROR (
            heading {
        heading: Erreur
    }
            layout {
        sequence: 70
    }
            source {
        
    }
        )

    )

    process do-import-csv (
        name: Run CSV import
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P40_DATA_TYPE = 'PRODUCTS' then
                    app_api.pkg_etl_legacy.dispatch_gcbrdd(
                        p_batch_size => 10000, p_max_batches => 10, p_etl_run_id => :P40_RUN_ID);
                elsif :P40_DATA_TYPE = 'CUSTOMERS' then
                    app_api.pkg_etl_legacy.dispatch_reference_table(
                        p_source_owner => 'CAISSE', p_source_table => 'GCPTIE',
                        p_target_owner => 'APP_PARTY', p_target_table => 'PARTY',
                        p_pk_column    => 'PARTY_CODE');
                end if;
                ```
        }
        execution {
        sequence: 10
    }
        successMessage {
            successMessage: Import terminé avec succès.
        }
        error {
        errorMessage: #SQLERRM_TEXT#
    }
        serverSideCondition {
            whenButtonPressed: @import_csv
        }
    )

)