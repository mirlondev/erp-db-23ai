page 40 (
    name: Bulk Import
    alias: BULK-IMPORT
    title: 📥 Import en masse (CSV)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorization: @regal-manager
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bulk-import-help (
        name: 📋 Comment importer vos données
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                u-color-2
            ]
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    pageItem P40_HELP (
        type: displayOnly
        label {
            label: Instructions
        }
        layout {
            sequence: 10
            region: @bulk-import-help
            slot: regionBody
        }
        appearance {
            template: @/hidden
        }
        value:
            ```html
            <ol>
              <li>Préparez un fichier CSV avec les colonnes attendues</li>
              <li>Format attendu pour produits : <code>codart,libart,tarifstd,unite,etat,codbarre</code></li>
              <li>Format attendu pour clients : <code>codtie,nomtie,adrtie1,ville,pays,telephone,email</code></li>
              <li>Cliquez sur "Choisir un fichier" puis "Importer"</li>
              <li>Les lignes en erreur sont listées en bas de page</li>
            </ol>
            ```
    )

    region csv-upload (
        name: 1️⃣ Charger le fichier CSV
        type: fileUpload
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    pageItem P40_CSV_FILE (
        type: fileBrowse
        label {
            label: Fichier CSV
        }
        layout {
            sequence: 10
            region: @csv-upload
            slot: regionBody
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            icon: fa-file-csv
        }
        storage {
            type: apexCollections
            collectionName: CSV_UPLOAD
        }
    )

    pageItem P40_CSV_TYPE (
        type: selectList
        label {
            label: Type de données
        }
        layout {
            sequence: 20
            region: @csv-upload
            slot: regionBody
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        listOfValues {
            staticValues: [
                PRODUCTS (Produits - codart,libart,tarifstd,unite,etat,codbarre)
                CUSTOMERS (Clients - codtie,nomtie,adrtie1,ville,pays,telephone,email)
                PRICES (Tarifs - codtarif,codart,tarif)
            ]
        }
        valueRequired: true
    )

    button import-csv (
        name: 📥 Lancer l'import
        label: Importer
        layout {
            sequence: 30
            region: @csv-upload
            slot: regionBody
            startNewRow: true
        }
        appearance {
            template: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
            ]
            hot: true
            icon: fa-upload
        }
    )

    process bulk-import-csv (
        name: Exécuter l'import CSV
        type: executePlsql
        serverSideCondition {
            type: requestEquals
            value: IMPORT
        }
        plsqlCode:
            ```plsql
            BEGIN
                CASE :P40_CSV_TYPE
                    WHEN 'PRODUCTS' THEN
                        app_api.pkg_etl_legacy.dispatch_gcbrdd(
                            p_batch_size => 10000, p_max_batches => 10, p_etl_run_id => :P40_RUN_ID);
                    WHEN 'CUSTOMERS' THEN
                        app_api.pkg_etl_legacy.dispatch_reference_table(
                            p_source_owner => 'CAISSE', p_source_table => 'GCPTIE',
                            p_target_owner => 'APP_PARTY', p_target_table => 'PARTY',
                            p_pk_column => 'PARTY_CODE');
                END CASE;
                COMMIT;
            END;
            ```
    )

    region import-result (
        name: 2️⃣ Résultats de l'import
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT etl_id,
                       source_table,
                       target_table,
                       rows_processed,
                       status,
                       TO_CHAR(started_at, 'DD/MM/YYYY HH24:MI:SS') AS started_at,
                       TO_CHAR(finished_at, 'DD/MM/YYYY HH24:MI:SS') AS finished_at,
                       SUBSTR(error_message, 1, 200) AS error
                  FROM app_api.etl_run_progress
                 WHERE started_at >= TRUNC(SYSDATE)
                 ORDER BY started_at DESC
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    breadcrumb bulk-import-bc (
        name: Bulk Import
        entry (
            label: 📥 Import CSV
            page: 40
        )
    )
)
