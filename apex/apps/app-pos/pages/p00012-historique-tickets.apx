                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TICKET_NO (
            type: numberField
            heading {
        heading: Ticket No
        alignment: end
    }
            layout {
                sequence: 20
                columnAlignment: end
            }
            validation {
        valueRequired: true
    }
            source {
                databaseColumn: TICKET_NO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TOTAL_HT (
            type: numberField
            heading {
        heading: Total Ht
        alignment: end
    }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: TOTAL_HT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TOTAL_TTC (
            type: numberField
            heading {
        heading: Total Ttc
        alignment: end
    }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                databaseColumn: TOTAL_TTC
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TOTAL_TVA (
            type: numberField
            heading {
        heading: Total Tva
        alignment: end
    }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                databaseColumn: TOTAL_TVA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column USER_CODE (
            type: textField
            heading {
