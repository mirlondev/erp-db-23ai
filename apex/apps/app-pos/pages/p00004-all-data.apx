page 4 (
    name: ALL_DATA
    alias: ALL_DATA
    title: ALL_DATA
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal_vendeur
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region all-data (
        name: ALL_DATA
        type: classicReport
        source {
            location: localDatabase
            tableName: DV_PRODUCT
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No data found.
        }

        column DATA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
        heading: Data
    }
            layout {
        sequence: 1
    }
            sorting {
                sortable: false
            }
        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
        breadcrumb: @breadcrumb
    }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

)

