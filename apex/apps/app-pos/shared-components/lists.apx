list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry quick-billing (
        label: Quick Billing
        icon {
            imageIconCssClasses: fa-bolt
        }
        layout {
            sequence: 15
        }
        isCurrent {
            type: pages
            pages: 20
        }
        link {
            target: {
                page: 20
            }
        }
    )

    entry all-data (
        label: All Data
        icon {
            imageIconCssClasses: fa-database
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: 4
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry rapport (
        label: Rapport
        icon {
            imageIconCssClasses: fa-table-pointer
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: 8
        }
        link {
            target: {
                page: 8
            }
        }
    )

    entry sessions-de-caisse (
        label: Sessions
        icon {
            imageIconCssClasses: fa-cash-register
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: 10
        }
        link {
            target: {
                page: 10
            }
        }
    )

    entry historique-tickets (
        label: Historique tickets
        icon {
            imageIconCssClasses: fa-receipt
        }
        layout {
            sequence: 50
        }
        isCurrent {
            type: pages
            pages: 12
        }
        link {
            target: {
                page: 12
            }
        }
    )

    entry z-de-caisse (
        label: Z de caisse
        icon {
            imageIconCssClasses: fa-money-bill
        }
        layout {
            sequence: 60
        }
        isCurrent {
            type: pages
            pages: [
                14
                15
            ]
        }
        link {
            target: {
                page: 14
            }
        }
    )

    entry customers (
        label: Customers
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 70
        }
        isCurrent {
            type: pages
            pages: 30
        }
        link {
            target: {
                page: 30
            }
        }
    )

    entry bulk-import (
        label: Bulk Import
        icon {
            imageIconCssClasses: fa-file-csv
        }
        layout {
            sequence: 80
        }
        isCurrent {
            type: pages
            pages: 40
        }
        link {
            target: {
                page: 40
            }
        }
    )

)
