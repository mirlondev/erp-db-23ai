page 20 (
    name: Journal
    alias: JOURNAL
    title: Journal des ecritures
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal-comptable
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region journal-list (
        name: Journal des ecritures
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(entry_date, 'DD/MM/YYYY') as entry_date,
                       entry_no,
                       journal_code,
                       doc_ref,
                       account_code,
                       account_name,
                       debit,
                       credit,
                       description,
                       created_by
                  from v_general_ledger
                 order by entry_date desc, entry_no desc, account_code
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }

        column ENTRY_DATE (
            type: plainText
            heading {
                heading: Date
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )

        column ENTRY_NO (
            type: plainText
            heading {
                heading: N°
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
        )

        column JOURNAL_CODE (
            type: plainText
            heading {
                heading: Journal
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column DOC_REF (
            type: plainText
            heading {
                heading: Doc
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_CODE (
            type: plainText
            heading {
                heading: Compte
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_NAME (
            type: plainText
            heading {
                heading: Libelle
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column DEBIT (
            type: plainText
            heading {
                heading: Debit
                alignment: end
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
        )

        column CREDIT (
            type: plainText
            heading {
                heading: Credit
                alignment: end
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: User
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
        )

        savedReport default-journal (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }
        )
    )

)
