page 10 (
    name: Chart of Accounts
    alias: CHART-OF-ACCOUNTS
    title: Plan comptable OHADA
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal-comptable
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region chart-of-accounts-search (
        name: Plan comptable SYSCOHADA
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select company_code,
                       account_code,
                       account_name,
                       decode(account_type,
                         'A', 'Actif immobilise',
                         'B', 'Bilan',
                         'C', 'Charges',
                         'P', 'Passif',
                         'T', 'Tresorerie',
                         'D', 'Produits',
                         account_type) as account_class,
                       short_code,
                       profile_code,
                       reporting_account,
                       currency_code,
                       case when is_active = 1 then 'Active' else 'Inactive' end as status
                  from app_gl.gl_account
                 order by company_code, account_code
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }

        column COMPANY_CODE (
            type: plainText
            heading {
                heading: Soc.
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_CODE (
            type: plainText
            heading {
                heading: Compte
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_NAME (
            type: plainText
            heading {
                heading: Libelle
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_CLASS (
            type: plainText
            heading {
                heading: Classe
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column SHORT_CODE (
            type: plainText
            heading {
                heading: Code court
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column PROFILE_CODE (
            type: plainText
            heading {
                heading: Profil
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column REPORTING_ACCOUNT (
            type: plainText
            heading {
                heading: Reporting
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column CURRENCY_CODE (
            type: plainText
            heading {
                heading: Devise
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Statut
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

        savedReport default-chart-accounts (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }
        )
    )
)