page 30 (
    name: Trial Balance
    alias: TRIAL-BALANCE
    title: Balance generale
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal-comptable
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region trial-balance-list (
        name: Balance generale
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select company_code,
                       account_code,
                       account_name,
                       account_class,
                       mvt_debit,
                       mvt_credit,
                       solde,
                       case
                         when solde > 0 and account_class in ('Actif','Bilan','Tresorerie') then 'Debiteur'
                         when solde < 0 and account_class in ('Actif','Bilan','Tresorerie') then 'Crediteur'
                         when solde > 0 and account_class in ('Passif')                      then 'Crediteur'
                         when solde < 0 and account_class in ('Passif')                      then 'Debiteur'
                         when account_class in ('Charges')                                  then 'Debiteur'
                         when account_class in ('Produits')                                 then 'Crediteur'
                         else '-'
                       end as sens
                  from v_gl_account_balance
                 order by company_code, account_code
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }

        column COMPANY_CODE (
            type: plainText
            heading {
                heading: Soc.
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_CODE (
            type: plainText
            heading {
                heading: Compte
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_NAME (
            type: plainText
            heading {
                heading: Libelle
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_CLASS (
            type: plainText
            heading {
                heading: Classe
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column MVT_DEBIT (
            type: plainText
            heading {
                heading: Debit (XAF)
                alignment: end
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
        )

        column MVT_CREDIT (
            type: plainText
            heading {
                heading: Credit (XAF)
                alignment: end
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
        )

        column SOLDE (
            type: plainText
            heading {
                heading: Solde (XAF)
                alignment: end
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
        )

        column SENS (
            type: plainText
            heading {
                heading: Sens
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        savedReport default-trial-balance (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }
        )
    )

)
