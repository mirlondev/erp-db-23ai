page 1 (
    name: Home
    alias: HOME
    title: Comptabilite Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal-comptable
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region welcome-hero (
        name: Welcome
        type: staticContent
        source {
            htmlCode:
                ```html
                <h1 style="margin:0;font-size:24px;font-weight:600;">REGAL Comptabilite &mdash; OHADA / CEMAC</h1>
                <p style="margin:4px 0 0;font-size:14px;opacity:.9;">Pointe-Noire / Brazzaville &mdash; <span id="todayDate"></span></p>
                <script>
                  document.getElementById('todayDate').innerText = new Date().toLocaleDateString('fr-FR', {weekday:'long', year:'numeric', month:'long', day:'numeric'});
                </script>
                ```
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                u-color-3
            ]
            icon: fa-calculator
        }
    )

    region compta-kpis (
        name: Comptabilite KPIs
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select label, valeur as value, null as url
                    from v_top_kpi_dashboard
                   where label in ('Encours total','Encours echu','CA MTD','Alertes critiques')
                   order by decode(label,'Encours total',1,'Encours echu',2,'CA MTD',3,'Alertes critiques',4)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--hiddenOverflow
            ]
        }
        settings {
            value: VALUE
            bottomLabel: LABEL
            layout: 4Columns
        }
    )

    region top-balances (
        name: Top soldes (Balance generale)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select company_code,
                       account_code,
                       account_name,
                       account_class,
                       mvt_debit,
                       mvt_credit,
                       solde
                  from v_gl_account_balance
                 order by abs(solde) desc
                 fetch first 15 rows only
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }

        column COMPANY_CODE (
            heading {
                heading: Co.
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_CODE (
            heading {
                heading: Account
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_NAME (
            heading {
                heading: Libelle
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column ACCOUNT_CLASS (
            heading {
                heading: Class
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column MVT_DEBIT (
            heading {
                heading: Debit (XAF)
                alignment: end
            }
            layout {
                sequence: 50
            }
            source {
                dataType: number
            }
        )

        column MVT_CREDIT (
            heading {
                heading: Credit (XAF)
                alignment: end
            }
            layout {
                sequence: 60
            }
            source {
                dataType: number
            }
        )

        column SOLDE (
            heading {
                heading: Solde (XAF)
                alignment: end
            }
            layout {
                sequence: 70
            }
            source {
                dataType: number
            }
        )
    )

    region quick-actions (
        name: Quick actions
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:8px 0;">
                  <a href="f?p=&APP_ID.:10:&APP_SESSION." class="t-Button t-Button--large t-Button--primary" style="text-align:center;text-decoration:none;">
                    <span class="fa-sitemap"></span>&nbsp;Plan comptable
                  </a>
                  <a href="f?p=&APP_ID.:20:&APP_SESSION." class="t-Button t-Button--large" style="text-align:center;text-decoration:none;">
                    <span class="fa-book"></span>&nbsp;Journal
                  </a>
                  <a href="f?p=&APP_ID.:30:&APP_SESSION." class="t-Button t-Button--large" style="text-align:center;text-decoration:none;">
                    <span class="fa-balance-scale"></span>&nbsp;Balance
                  </a>
                  <a href="f?p=&APP_ID.:40:&APP_SESSION." class="t-Button t-Button--large" style="text-align:center;text-decoration:none;">
                    <span class="fa-file-invoice"></span>&nbsp;Declarations
                  </a>
                </div>
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )
)