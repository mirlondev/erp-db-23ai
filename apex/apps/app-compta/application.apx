app APP-COMPTA (
    name: APP_COMPTA
    logo {
        type: text
        text: APP_COMPTA
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            t-TreeNav--styleA
            js-navCollapsed--hidden
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @regal-auth
    }
    sessionStateProtection {
        checksumSalt: 4A7B2C9E1F3D5A8B6C4E2F9A1D7B5C3E8F6A4C7B2E9D1F5A8C3E6B4D7F2A9C5E1
    }
    runtime {
        allowFeedback: true
    }
    globalization {
        primaryLanguage: fr
        languageDerivedFrom: session
    }

    substitution APP_NAME (
        value {
            staticValue: REGAL Comptabilite
        }
    )

    substitution COMPANY_NAME (
        value {
            staticValue: LITOKO SARL Brazzaville
        }
    )

    substitution CURRENCY_CODE (
        value {
            staticValue: XAF
        }
    )

)
