    name: Page Navigation

    entry suppliers (
        label: Fournisseurs
        icon {
            imageIconCssClasses: fa-truck
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10
            }
        }
    )

    entry purchase-orders (
        label: Bons de commande
        icon {
            imageIconCssClasses: fa-shopping-cart
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 20
            }
        }
    )

    entry receptions (
        label: Bons de livraison
        icon {
            imageIconCssClasses: fa-truck-loading
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 30
            }
        }
    )

    entry supplier-products (
        label: Catalogue articles
        icon {
            imageIconCssClasses: fa-boxes
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 40
            }
        }
    }

)
