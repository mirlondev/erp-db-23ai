page 50 (
    name: 'Bulk Stock Import'
    alias: BULK_IMPORT
    title: 'Import Stock CSV — LITOKO'
    security {
        authorizationScheme: @regal_manager
        pageAccessProtection: argumentsMustHaveChecksum
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }

    region breadcrumb (
        type: breadcrumb
        slot: breadcrumbBar
        template: @/title-bar
        templateOptions: t-BreadcrumbRegion--useBreadcrumbTitle
    )

    region import-steps (
        type: staticContent
        name: 'Étapes import'
        slot: body
        seq: 5
        template: @/wizard-container
        templateOptions: #DEFAULT#
        source {
            type: htmlCode
            htmlCode: '''
                <div class="t-Wizard-steps">
                  <div class="t-Wizard-step is-active"><span class="t-Wizard-stepNumber">1</span><span class="t-Wizard-stepLabel">Préparer le CSV</span></div>
                  <div class="t-Wizard-step"><span class="t-Wizard-stepNumber">2</span><span class="t-Wizard-stepLabel">Uploader</span></div>
                  <div class="t-Wizard-step"><span class="t-Wizard-stepNumber">3</span><span class="t-Wizard-stepLabel">Résultats</span></div>
                </div>
            '''
        }
    )

    region help-text (
        type: staticContent
        name: 'Format attendu'
        slot: body
        seq: 10
        template: @/collapsible
        templateOptions: is-collapsed t-Region--scrollBody
        source {
            type: htmlCode
            htmlCode: '''
                <p><strong>Colonnes CSV requises :</strong> <code>codart, coddep, qte_stock, pmp</code></p>
                <p>Exemple : <code>ART001,DEP-PNR,250,1500</code></p>
                <p class="t-Alert--info">Encodage UTF-8, séparateur virgule, taille max 50 Mo.</p>
            '''
        }
    )

    region upload-region (
        type: staticContent
        name: 'Upload stock CSV'
        slot: body
        seq: 20
        template: @/standard
        templateOptions: t-Region--scrollBody

        pageItem P50_CSV_FILE (
            type: fileUpload
            label: 'Fichier CSV stock'
            layout {
                region: @upload_region
                slot: regionBody
                seq: 10
            }
            appearance {
                template: @/required
                templateOptions: t-Form-fieldContainer--large
                width: 64
                display: displayAs
                displayAs: blockDropzone
            }
            behavior {
                dropzoneDesc: 'Glisser-déposer le CSV stock ici ou cliquer pour parcourir (max 50 Mo)'
                storage {
                    type: appTempFiles
                    maxFileSize: 50000
                }
            }
            validation {
        valueRequired: true
    }
        )

        button import_stock (
            buttonName: IMPORT_STOCK
            label: 'Importer le stock'
            layout {
                region: @upload_region
                slot: regionBody
                seq: 20
                startNewRow: true
            }
            appearance {
                buttonTemplate: @/text-with-icon
                templateOptions: t-Button--large
                hot: true
            }
            behavior {
                action: submitPage
                warnOnUnsavedChanges: doNotCheck
            }
        )
    )

    region import-result (
        type: classicReport
        name: 'Résultats import stock'
        slot: body
        seq: 30
        template: @/standard
        templateOptions: t-Region--scrollBody
        source {
            type: sqlQuery
            sqlQuery: ```sql
                select etl_id,
                       source_table,
                       target_table,
                       rows_processed,
                       case when status = 'OK' then '<span class="t-Badge t-Badge--success">OK</span>'
                            when status = 'ERROR' then '<span class="t-Badge t-Badge--danger">ERREUR</span>'
                            else '<span class="t-Badge t-Badge--neutral">' || status || '</span>'
                       end as status_html,
                       to_char(started_at, 'DD/MM/YYYY HH24:MI') as started
                  from app_api.etl_run_progress
                 where source_table = 'CAISSE.GCSTOCK'
                   and started_at >= trunc(sysdate)
                 order by started_at desc
            ```
        }
        
        column ETL_ID (
            type: plainText
            heading {
        heading: 'ETL ID'
    }
            layout {
        seq: 10
    }
        )
        column SOURCE_TABLE (
            type: plainText
            heading {
        heading: 'Source'
    }
            layout {
        seq: 20
    }
        )
        column TARGET_TABLE (
            type: plainText
            heading {
        heading: 'Cible'
    }
            layout {
        seq: 30
    }
        )
        column ROWS_PROCESSED (
            type: plainText
            heading {
        heading: 'Lignes'
        alignment: end
    }
            layout {
        seq: 40
    }
        )
        column STATUS_HTML (
            type: htmlContent
            heading {
        heading: 'Statut'
    }
            layout {
        seq: 50
    }
            source {
        dataType: STRING
    }
        )
        column STARTED (
            type: plainText
            heading {
        heading: 'Démarré'
    }
            layout {
        seq: 60
    }
        )

        appearance {
            componentAppearance {
                template: @/standard
                templateOptions: t-Report--stretch t-Report--horizontalBorders
            }
        }
    )

    process do-import-stock (
        type: executeCode
        layout {
        seq: 10
    }
        execution {
        whenButtonPressed: @import_stock
    }
        source {
            plsqlCode: ```plsql
                app_api.pkg_etl_legacy.dispatch_reference_table(
                    p_source_owner => 'CAISSE',
                    p_source_table => 'GCSTOCK',
                    p_target_owner => 'APP_INV',
                    p_target_table => 'INV_STOCK',
                    p_pk_column    => 'PRODUCT_CODE');
            ```
        }
        messages {
            successMessage: 'Import stock terminé.'
            errorMessage: #SQLERRM_TEXT#
        }
    )
)