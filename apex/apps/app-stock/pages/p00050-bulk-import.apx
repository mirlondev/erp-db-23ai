page 50 (
    name: Bulk Stock Import
    alias: BULK-IMPORT
    title: Bulk Stock Import
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal-manager
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region help-text (
        name: How to import
        type: staticContent
        source {
            htmlCode: <p>Upload a stock CSV with columns: codart, coddep, qte_stock, pmp. Maximum file size: 50 MB.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    region upload-region (
        name: Upload stock CSV
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P50_CSV_FILE (
        type: fileUpload
        label {
            label: CSV file
            alignment: left
        }
        display {
            displayAs: blockDropzone
            dropzoneDesc: Drop stock CSV here or click to browse
        }
        storage {
            type: appTempFiles
            maxFileSize: 50000
        }
        layout {
            sequence: 10
            region: @upload-region
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 64
        }
        validation {
            valueRequired: true
        }
    )

    button import-stock (
        buttonName: IMPORT_STOCK
        label: Import stock
        layout {
            sequence: 20
            region: @upload-region
            slot: regionBody
            startNewRow: true
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
            hot: true
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    region import-result (
        name: Import results
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select etl_id,
                       source_table,
                       target_table,
                       rows_processed,
                       status,
                       to_char(started_at, 'DD/MM/YYYY HH24:MI') as started
                  from app_api.etl_run_progress
                 where source_table = 'CAISSE.GCSTOCK'
                   and started_at >= trunc(sysdate)
                 order by started_at desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
        }

        column ETL_ID (
            reportColumnQueryId: 100
            derivedColumn: N
            heading {
                heading: ETL ID
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column SOURCE_TABLE (
            reportColumnQueryId: 200
            derivedColumn: N
            heading {
                heading: Source
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column TARGET_TABLE (
            reportColumnQueryId: 300
            derivedColumn: N
            heading {
                heading: Target
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column ROWS_PROCESSED (
            reportColumnQueryId: 400
            derivedColumn: N
            heading {
                heading: Rows
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column STATUS (
            reportColumnQueryId: 500
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column STARTED (
            reportColumnQueryId: 600
            derivedColumn: N
            heading {
                heading: Started
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )
    )

    process do-import-stock (
        name: Run stock import
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                app_api.pkg_etl_legacy.dispatch_reference_table(
                    p_source_owner => 'CAISSE',
                    p_source_table => 'GCSTOCK',
                    p_target_owner => 'APP_INV',
                    p_target_table => 'INV_STOCK',
                    p_pk_column    => 'PRODUCT_CODE');
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Import stock terminé.
        }
        error {
            errorMessage: #SQLERRM_TEXT#
        }
        serverSideCondition {
            whenButtonPressed: @import-stock
        }
    )
)