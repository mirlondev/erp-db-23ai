page 2 (
    name: stcoc
    alias: STCOC
    title: stcoc
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal-vendeur
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>You can insert, update, and delete data directly within this interactive grid.<br>
              Insert a new row by clicking the Add Row button.<br>
              Double click into a cell, or click the <strong>Edit</strong> button to update data values, similar to editing data in a spreadsheet.</p>
            
            <p>Use the Row Actions menu ( <span class="fa fa-bars" aria-hidden="true"></span> ) at the top of the report to duplicate, delete, refresh or revert selected rows.<br> 
              Use the Row Actions menu on individual rows to also access the single row view or add a new row.</p>
            
            <p>To find data enter a search term into the search dialog, or click on the column headings to limit the records returned.</p>
            
            <p>You can perform numerous functions by clicking the <strong>Actions</strong> button. This includes selecting the columns that are displayed / hidden and their display sequence, plus numerous data and format functions.  You can also define an additional view of the data using the chart option.</p>
            
            <p>If you want to save your customizations select report, or click download to unload the data.<p>
            
            <p>For additional information click Help at the bottom of the Actions menu.</p> 
            
            <p>Click the <strong>Reset</strong> button to reset the interactive grid back to the default settings.</p>
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region stcoc (
        name: Stock
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: INV_STOCK
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 2602841003004022
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @WAREHOUSE_CODE
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @PRODUCT_CODE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @STOCK_QTY
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ORDERED_QTY
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @RESERVED_QTY
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @LOANED_QTY
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @LAST_OUT_AT
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @LAST_IN_AT
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @LAST_COUNT_QTY
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @LAST_COUNT_AT
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @LOCATION
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @PENDING_QTY
                layout {
                    sequence: 12
                }
            )

            displayColumn (
                column: @UPDATED_AT
                layout {
                    sequence: 13
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column LAST_COUNT_AT (
            type: datePicker
            heading {
                heading: Last Count At
            }
            layout {
                sequence: 120
            }
            source {
                databaseColumn: LAST_COUNT_AT
                dataType: date
            }
        )

        column LAST_COUNT_QTY (
            type: numberField
            heading {
                heading: Last Count Qty
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                databaseColumn: LAST_COUNT_QTY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column LAST_IN_AT (
            type: datePicker
            heading {
                heading: Last In At
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: LAST_IN_AT
                dataType: date
            }
        )

        column LAST_OUT_AT (
            type: datePicker
            heading {
                heading: Last Out At
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: LAST_OUT_AT
                dataType: date
            }
        )

        column LOANED_QTY (
            type: numberField
            heading {
                heading: Loaned Qty
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            source {
                databaseColumn: LOANED_QTY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column LOCATION (
            type: textField
            heading {
                heading: Location
            }
            layout {
                sequence: 130
            }
            validation {
                maxLength: 40
            }
            source {
                databaseColumn: LOCATION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ORDERED_QTY (
            type: numberField
            heading {
                heading: Ordered Qty
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            source {
                databaseColumn: ORDERED_QTY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PENDING_QTY (
            type: numberField
            heading {
                heading: Pending Qty
                alignment: end
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            source {
                databaseColumn: PENDING_QTY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PRODUCT_CODE (
            type: hidden
            heading {
                heading: Product Code
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: PRODUCT_CODE
                dataType: varchar2
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column RESERVED_QTY (
            type: numberField
            heading {
                heading: Reserved Qty
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            source {
                databaseColumn: RESERVED_QTY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column STOCK_QTY (
            type: numberField
            heading {
                heading: Stock Qty
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            source {
                databaseColumn: STOCK_QTY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column UPDATED_AT (
            type: datePicker
            heading {
                heading: Updated At
            }
            layout {
                sequence: 150
            }
            source {
                databaseColumn: UPDATED_AT
                dataType: timestamp
            }
        )

        column WAREHOUSE_CODE (
            type: hidden
            heading {
                heading: Warehouse Code
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: WAREHOUSE_CODE
                dataType: varchar2
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    process stcoc-save-interactive-grid-data (
        name: stcoc - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @stcoc
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2618352469004181
        }
    )

)

