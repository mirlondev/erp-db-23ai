page 20 (
    name: Low Stock Alerts
    alias: LOW-STOCK
    title: ⚠️ Alertes stock bas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorization: @regal-manager
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region low-stock-summary (
        name: Alertes par niveau
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    CASE
                        WHEN NVL(s.stock_qty, 0) = 0                       THEN 'RUPTURE'
                        WHEN NVL(s.stock_qty, 0) <= NVL(p.min_stock_qty, 0)  THEN 'STOCK BAS'
                        ELSE 'OK'
                    END AS alert_level,
                    COUNT(DISTINCT s.product_code) AS nb_products,
                    SUM(NVL(s.stock_qty, 0))        AS total_units,
                    COUNT(DISTINCT s.warehouse_code) AS nb_warehouses
                FROM app_inv.inv_stock s
                JOIN app_product.product p ON p.product_code = s.product_code
                WHERE NVL(s.stock_qty, 0) <= NVL(p.min_stock_qty, 0)
                GROUP BY
                    CASE
                        WHEN NVL(s.stock_qty, 0) = 0                       THEN 'RUPTURE'
                        WHEN NVL(s.stock_qty, 0) <= NVL(p.min_stock_qty, 0)  THEN 'STOCK BAS'
                        ELSE 'OK'
                    END
                ORDER BY alert_level
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region low-stock-details (
        name: Produits à réapprovisionner
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT s.warehouse_code,
                       s.product_code,
                       p.product_name,
                       p.short_name,
                       NVL(s.stock_qty, 0) AS stock_qty,
                       NVL(p.min_stock_qty, 0) AS min_stock_qty,
                       NVL(p.max_stock_qty, 0) AS max_stock_qty,
                       NVL(p.min_stock_qty, 0) - NVL(s.stock_qty, 0) AS qty_to_order,
                       NVL(p.standard_price, 0) AS unit_cost_xaf,
                       ROUND(
                         (NVL(p.min_stock_qty, 0) - NVL(s.stock_qty, 0))
                         * NVL(p.standard_price, 0), 0
                       ) AS reorder_cost_xaf,
                       CASE
                         WHEN NVL(s.stock_qty, 0) = 0                       THEN '🔴 RUPTURE'
                         WHEN NVL(s.stock_qty, 0) <= NVL(p.min_stock_qty, 0)  THEN '🟠 BAS'
                         ELSE '🟢 OK'
                       END AS alert,
                       p.category_id
                  FROM app_inv.inv_stock s
                  JOIN app_product.product p ON p.product_code = s.product_code
                 WHERE NVL(s.stock_qty, 0) <= NVL(p.min_stock_qty, 0)
                 ORDER BY stock_qty ASC, qty_to_order DESC
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        download {
            formats: [
                csv
                excel
                pdf
            ]
        }
    )

    breadcrumb low-stock-bc (
        name: Low Stock
        entry (
            label: ⚠️ Alertes stock
            page: 20
        )
    )
)
