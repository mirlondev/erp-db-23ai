page 20 (
    name: Low Stock
    alias: LOW-STOCK
    title: Low Stock Alerts
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal-manager
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region low-stock-list (
        name: Products to reorder
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.warehouse_code,
                       s.product_code,
                       p.product_name,
                       nvl(s.stock_qty, 0) as stock_qty,
                       nvl(p.min_stock_qty, 0) as min_stock_qty,
                       nvl(p.min_stock_qty, 0) - nvl(s.stock_qty, 0) as qty_to_order,
                       nvl(p.standard_price, 0) as unit_cost_xaf,
                       round(
                         (nvl(p.min_stock_qty, 0) - nvl(s.stock_qty, 0))
                         * nvl(p.standard_price, 0), 0
                       ) as reorder_cost_xaf,
                       case
                         when nvl(s.stock_qty, 0) = 0                       then 'RUPTURE'
                         when nvl(s.stock_qty, 0) <= nvl(p.min_stock_qty, 0)  then 'BAS'
                         else 'OK'
                       end as alert
                  from app_inv.inv_stock s
                  join app_product.product p on p.product_code = s.product_code
                 where nvl(s.stock_qty, 0) <= nvl(p.min_stock_qty, 0)
                 order by stock_qty asc, qty_to_order desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
        }

        column WAREHOUSE_CODE (
            reportColumnQueryId: 100
            derivedColumn: N
            heading {
                heading: Warehouse
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column PRODUCT_CODE (
            reportColumnQueryId: 200
            derivedColumn: N
            heading {
                heading: Code
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column PRODUCT_NAME (
            reportColumnQueryId: 300
            derivedColumn: N
            heading {
                heading: Product
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column STOCK_QTY (
            reportColumnQueryId: 400
            derivedColumn: N
            heading {
                heading: Stock
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column MIN_STOCK_QTY (
            reportColumnQueryId: 500
            derivedColumn: N
            heading {
                heading: Min
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column QTY_TO_ORDER (
            reportColumnQueryId: 600
            derivedColumn: N
            heading {
                heading: To order
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column UNIT_COST_XAF (
            reportColumnQueryId: 700
            derivedColumn: N
            heading {
                heading: Unit cost
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column REORDER_COST_XAF (
            reportColumnQueryId: 800
            derivedColumn: N
            heading {
                heading: Reorder cost
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column ALERT (
            reportColumnQueryId: 900
            derivedColumn: N
            heading {
                heading: Alert
            }
            layout {
                sequence: 90
            }
            sorting {
                sortable: false
            }
        )
    )
)