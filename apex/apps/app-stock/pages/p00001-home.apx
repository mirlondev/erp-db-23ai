page 1 (
    name: Home
    alias: HOME
    title: APP_STOCK Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal-vendeur
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region app-stock-hero (
        name: APP_STOCK Dashboard
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region kpi-cards (
        name: KPIs Stock
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select label,
                       valeur as value,
                       case label
                         when 'Ruptures stock'  then 'fa-warehouse'
                         when 'Lots < 30j'      then 'fa-clock'
                         when 'Encours total'   then 'fa-hand-holding-usd'
                         when 'Encours echu'    then 'fa-exclamation-circle'
                         when 'Alertes critiques' then 'fa-bell'
                         when 'CA jour'         then 'fa-money-bill-wave'
                         when 'Tickets jour'    then 'fa-receipt'
                         when 'Panier moyen'    then 'fa-shopping-basket'
                         else 'fa-chart-bar'
                       end as icon,
                       null as link
                  from v_top_kpi_dashboard
                 where label in ('Ruptures stock','Lots < 30j','Encours total','Encours echu')
                 order by decode(label,'Ruptures stock',1,'Lots < 30j',2,'Encours total',3,'Encours echu',4)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleA
            ]
        }
        componentAppearance {
            gridColumns: 4
            template: @/cards
            templateOptions: [
                #DEFAULT#
                u-colors
                t-Cards--featured t-Cards--block force-fa-lg
                t-Cards--displayIcons
                t-Cards--animColorFill
            ]
        }
        title {
            column: LABEL
        }
        body {
            column: VALUE
            advancedFormatting: true
            htmlExpression: <span class="t-Card-subtitle">&VALUE.</span>
        }
        media {
            advancedFormatting: true
            htmlExpression: <span class="fa-4x &ICON."></span>
        }
    }

    region page-navigation (
        name: Page Navigation
        type: list
        source {
            list: @page-navigation
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                u-colors
                t-Cards--featured t-Cards--block force-fa-lg
                t-Cards--displayIcons
                t-Cards--4cols
                t-Cards--hideBody
                t-Cards--animColorFill
            ]
        }
    )

)
