page 1 (
    name: Home
    alias: HOME
    title: APP_STOCK
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal-vendeur
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region app-stock (
        name: APP_STOCK
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region page-navigation (
        name: Page Navigation
        type: list
        source {
            list: @page-navigation
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                u-colors
                t-Cards--featured t-Cards--block force-fa-lg
                t-Cards--displayIcons
                t-Cards--4cols
                t-Cards--hideBody
                t-Cards--animColorFill
            ]
        }
    )

)

