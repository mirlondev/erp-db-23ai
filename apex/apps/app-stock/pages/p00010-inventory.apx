apex.schema.version: 26.1

page 10 (
    name: 'Inventory'
    alias: INVENTORY
    title: 'Inventaire Stock — LITOKO'
    security {
        authorizationScheme: @regal_vendeur
        pageAccessProtection: argumentsMustHaveChecksum
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }

    region breadcrumb (
        type: breadcrumb
        layout {
        slot: breadcrumbBar
    }
        appearance {
            template: @/title-bar
            templateOptions: [ t-BreadcrumbRegion--useBreadcrumbTitle ]
        }
    )

    region inventory-kpi (
        name: 'Inventory KPIs'
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [ t-Region--noPadding t-Region--removeHeader js-removeLandmark ]
        }

        pageItem P10_KPI_REFS (
            type: displayOnly
            label {
        label: Références
    }
            layout {
        column: 1
    }
            source {
                type: plsqlExpression
                plsqlExpression: '''to_char(app_api.apex_kpi_stock_refs, ''FM999,999'')'''
                used: always
            }
            appearance {
                template: @/optional-floating
                templateOptions: [ t-Form-fieldContainer--large ]
            }
        )

        pageItem P10_KPI_UNITS (
            type: displayOnly
            label {
        label: Total unités
    }
            layout {
        column: 2
    }
            source {
                type: plsqlExpression
                plsqlExpression: '''to_char(app_api.apex_kpi_stock_units, ''FM999,999'')'''
                used: always
            }
            appearance {
                template: @/optional-floating
                templateOptions: [ t-Form-fieldContainer--large ]
            }
        )

        pageItem P10_KPI_VALUE (
            type: displayOnly
            label {
        label: Valeur stock (XAF)
    }
            layout {
        column: 3
    }
            source {
                type: plsqlExpression
                plsqlExpression: '''to_char(app_api.apex_kpi_stock_value_xaf, ''FM999,999,999'')'''
                used: always
            }
            appearance {
                template: @/optional-floating
                templateOptions: [ t-Form-fieldContainer--large ]
            }
        )

        pageItem P10_KPI_LOWSTOCK (
            type: displayOnly
            label {
        label: Stock bas
    }
            layout {
        column: 4
    }
            source {
                type: plsqlExpression
                plsqlExpression: '''to_char(app_api.apex_kpi_stock_low_count, ''FM999,999'')'''
                used: always
            }
            appearance {
                template: @/optional-floating
                templateOptions: [ t-Form-fieldContainer--large ]
            }
        )
    )

    region actions-bar (
        name: 'Actions'
        type: staticContent
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [ t-Region--noPadding t-Region--removeHeader js-removeLandmark ]
        }

        button btn_new_transfer (
            buttonName: 'NEW_TRANSFER'
            label: 'Nouveau transfert'
            layout {
                column: 1
                slot: regionBody
                startNewRow: true
            }
            appearance {
                buttonTemplate: @/text-with-icon
                templateOptions: [ #DEFAULT# t-Button--large ]
                hot: true
            }
            behavior {
                action: redirectToPage
                target: page 40
            }
        )

        button btn_bulk_import (
            buttonName: 'BULK_IMPORT'
            label: 'Importer CSV'
            layout {
                column: 2
                slot: regionBody
                startNewRow: false
            }
            appearance {
                buttonTemplate: @/text-with-icon
                templateOptions: [ #DEFAULT# t-Button--large ]
            }
            behavior {
                action: redirectToPage
                target: page 50
            }
        )
    )

    region inventory-list (
        name: 'Stock par dépôt'
        type: interactiveReport
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [ t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc ]
        }
        source {
            type: sqlQuery
            sqlQuery: ```sql
select s.warehouse_code,
       p.product_code,
       p.product_name,
       p.product_category,
       nvl(s.stock_qty, 0) as stock_qty,
       nvl(s.ordered_qty, 0) as ordered_qty,
       nvl(s.reserved_qty, 0) as reserved_qty,
       nvl(s.ordered_qty, 0) - nvl(s.reserved_qty, 0) as available,
       nvl(p.standard_price, 0) as unit_price,
       round(nvl(s.stock_qty, 0) * nvl(p.standard_price, 0), 0) as value_xaf,
       case
         when nvl(s.stock_qty, 0) = 0                        then 'RUPTURE'
         when nvl(s.stock_qty, 0) <= nvl(p.min_stock_qty, 0) then 'BAS'
         when nvl(s.stock_qty, 0) >= nvl(p.max_stock_qty, 0) then 'PLEIN'
         else 'OK'
       end as stock_status,
       case
         when nvl(s.stock_qty, 0) = 0                        then '<span class="t-Badge t-Badge--danger">RUPTURE</span>'
         when nvl(s.stock_qty, 0) <= nvl(p.min_stock_qty, 0) then '<span class="t-Badge t-Badge--warning">BAS</span>'
         when nvl(s.stock_qty, 0) >= nvl(p.max_stock_qty, 0) then '<span class="t-Badge t-Badge--info">PLEIN</span>'
         else '<span class="t-Badge t-Badge--success">OK</span>'
       end as status_badge
  from app_inv.inv_stock s
  join app_product.product p on p.product_code = s.product_code
 where s.stock_qty >= 0
 order by s.warehouse_code, p.product_name
```
        }
        
        column WAREHOUSE_CODE (
            type: plainText
            heading {
        heading: Dépôt
    }
            layout {
        sequence: 10
    }
            dataType: STRING
        )
        column PRODUCT_CODE (
            type: plainText
            heading {
        heading: Code
    }
            layout {
        sequence: 20
    }
            dataType: STRING
        )
        column PRODUCT_NAME (
            type: plainText
            heading {
        heading: Produit
    }
            layout {
        sequence: 30
    }
            dataType: STRING
        )
        column PRODUCT_CATEGORY (
            type: plainText
            heading {
        heading: Catégorie
    }
            layout {
        sequence: 35
    }
            dataType: STRING
        )
        column STOCK_QTY (
            type: plainText
            heading {
        heading: Stock
        alignment: end
    }
            layout {
        sequence: 40
    }
            dataType: NUMBER
        )
        column ORDERED_QTY (
            type: plainText
            heading {
        heading: Commandé
        alignment: end
    }
            layout {
        sequence: 50
    }
            dataType: NUMBER
        )
        column RESERVED_QTY (
            type: plainText
            heading {
        heading: Réservé
        alignment: end
    }
            layout {
        sequence: 60
    }
            dataType: NUMBER
        )
        column AVAILABLE (
            type: plainText
            heading {
        heading: Disponible
        alignment: end
    }
            layout {
        sequence: 70
    }
            dataType: NUMBER
        )
        column UNIT_PRICE (
            type: plainText
            heading {
        heading: Prix unit.
        alignment: end
    }
            layout {
        sequence: 80
    }
            dataType: NUMBER
        )
        column VALUE_XAF (
            type: plainText
            heading {
        heading: Valeur XAF
        alignment: end
    }
            layout {
        sequence: 90
    }
            dataType: NUMBER
        )
        column STOCK_STATUS (
            type: plainText
            heading {
        heading: Statut
    }
            layout {
        sequence: 100
    }
            dataType: STRING
            isHidden: true
        )
        column STATUS_BADGE (
            type: htmlContent
            heading {
        heading: Statut
    }
            layout {
        sequence: 110
    }
            dataType: STRING
        )

        savedReport default-inventory (
            visibility: primaryDefault
            rowsPerPage: 25
            sort {
                column: STOCK_STATUS
                direction: desc
            }
            sort {
                column: VALUE_XAF
                direction: desc
            }
        )
    )
)