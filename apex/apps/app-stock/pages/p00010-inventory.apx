page 10 (
    name: Inventory
    alias: INVENTORY
    title: 📦 Inventaire par dépôt
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorization: @regal-vendeur
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region inventory-kpi (
        name: KPI Inventaire
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader
            ]
        }
    )

    pageItem P10_KPI_REFS (
        type: displayOnly
        label {
            label: 📊 Références
        }
        layout {
            sequence: 10
            region: @inventory-kpi
            slot: regionBody
            column: 1
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
                u-color-1
            ]
            valueAlignment: center
        }
    )

    pageItem P10_KPI_UNITS (
        type: displayOnly
        label {
            label: 📦 Unités totales
        }
        layout {
            sequence: 20
            region: @inventory-kpi
            slot: regionBody
            column: 2
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
                u-color-2
            ]
            valueAlignment: center
        }
    )

    pageItem P10_KPI_VALUE (
        type: displayOnly
        label {
            label: 💰 Valeur stock (XAF)
        }
        layout {
            sequence: 30
            region: @inventory-kpi
            slot: regionBody
            column: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
                u-color-3
            ]
            valueAlignment: center
        }
    )

    pageItem P10_KPI_LOWSTOCK (
        type: displayOnly
        label {
            label: ⚠️ Stock bas
        }
        layout {
            sequence: 40
            region: @inventory-kpi
            slot: regionBody
            column: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
                u-color-4
            ]
            valueAlignment: center
        }
    )

    region inventory-list (
        name: Stock par dépôt
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- FIX audit 2026-10-03 : NVL sur prix nullable
                SELECT s.warehouse_code,
                       p.product_code,
                       p.product_name,
                       p.short_name,
                       c.category_name,
                       b.brand_name,
                       s.stock_qty,
                       s.ordered_qty,
                       s.reserved_qty,
                       NVL(s.ordered_qty, 0) - NVL(s.reserved_qty, 0) AS available,
                       NVL(p.standard_price, 0) AS unit_price,
                       ROUND(NVL(s.stock_qty, 0) * NVL(p.standard_price, 0), 0) AS value_xaf,
                       p.min_stock_qty,
                       p.max_stock_qty,
                       CASE
                         WHEN NVL(s.stock_qty, 0) = 0                       THEN 'RUPTURE'
                         WHEN NVL(s.stock_qty, 0) <= NVL(p.min_stock_qty, 0)  THEN 'BAS'
                         WHEN NVL(s.stock_qty, 0) >= NVL(p.max_stock_qty, 0)  THEN 'PLEIN'
                         ELSE 'OK'
                       END AS stock_status,
                       TO_CHAR(s.last_in_at,  'DD/MM/YYYY HH24:MI') AS last_in,
                       TO_CHAR(s.last_out_at, 'DD/MM/YYYY HH24:MI') AS last_out
                  FROM app_inv.inv_stock s
                  JOIN app_product.product p           ON p.product_code  = s.product_code
                  LEFT JOIN app_product.prod_category c ON c.category_id   = p.category_id
                  LEFT JOIN app_product.prod_brand    b ON b.brand_id      = p.brand_id
                 WHERE s.stock_qty > 0
                 ORDER BY s.warehouse_code, p.product_name
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 2602841003004022
        }
    )

    breadcrumb inventory-bc (
        name: Inventory
        entry (
            label: 📦 Inventaire
            page: 10
        )
    )
)
