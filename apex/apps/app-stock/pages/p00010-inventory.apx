page 10 (
    name: Inventory
    alias: INVENTORY
    title: Inventory
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal-vendeur
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region inventory-kpi (
        name: Inventory KPIs
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    pageItem P10_KPI_REFS (
        type: displayOnly
        label {
            label: References
        }
        layout {
            sequence: 10
            region: @inventory-kpi
            slot: regionBody
            column: 1
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        source {
            type: functionBody
            functionBody:
                ```plsql
                return to_char(app_api.apex_kpi_stock_refs, 'FM999,999');
                ```
            used: always
        }
    )

    pageItem P10_KPI_UNITS (
        type: displayOnly
        label {
            label: Total units
        }
        layout {
            sequence: 20
            region: @inventory-kpi
            slot: regionBody
            column: 2
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        source {
            type: functionBody
            functionBody:
                ```plsql
                return to_char(app_api.apex_kpi_stock_units, 'FM999,999');
                ```
            used: always
        }
    )

    pageItem P10_KPI_VALUE (
        type: displayOnly
        label {
            label: Stock value (XAF)
        }
        layout {
            sequence: 30
            region: @inventory-kpi
            slot: regionBody
            column: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        source {
            type: functionBody
            functionBody:
                ```plsql
                return to_char(app_api.apex_kpi_stock_value_xaf, 'FM999,999,999');
                ```
            used: always
        }
    )

    pageItem P10_KPI_LOWSTOCK (
        type: displayOnly
        label {
            label: Low stock
        }
        layout {
            sequence: 40
            region: @inventory-kpi
            slot: regionBody
            column: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
        source {
            type: functionBody
            functionBody:
                ```plsql
                return to_char(app_api.apex_kpi_stock_low_count, 'FM999,999');
                ```
            used: always
        }
    )

    region inventory-list (
        name: Stock by warehouse
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.warehouse_code,
                       p.product_code,
                       p.product_name,
                       nvl(s.stock_qty, 0) as stock_qty,
                       nvl(s.ordered_qty, 0) as ordered_qty,
                       nvl(s.reserved_qty, 0) as reserved_qty,
                       nvl(s.ordered_qty, 0) - nvl(s.reserved_qty, 0) as available,
                       nvl(p.standard_price, 0) as unit_price,
                       round(nvl(s.stock_qty, 0) * nvl(p.standard_price, 0), 0) as value_xaf,
                       case
                         when nvl(s.stock_qty, 0) = 0                       then 'RUPTURE'
                         when nvl(s.stock_qty, 0) <= nvl(p.min_stock_qty, 0)  then 'BAS'
                         when nvl(s.stock_qty, 0) >= nvl(p.max_stock_qty, 0)  then 'PLEIN'
                         else 'OK'
                       end as stock_status
                  from app_inv.inv_stock s
                  join app_product.product p on p.product_code = s.product_code
                 where s.stock_qty > 0
                 order by s.warehouse_code, p.product_name
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }

        column WAREHOUSE_CODE (
            type: plainText
            heading {
                heading: Warehouse
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )

        column PRODUCT_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column PRODUCT_NAME (
            type: plainText
            heading {
                heading: Product
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column STOCK_QTY (
            type: plainText
            heading {
                heading: Stock
                alignment: end
            }
            layout {
                sequence: 40
            }
            source {
                dataType: number
            }
        )

        column ORDERED_QTY (
            type: plainText
            heading {
                heading: Ordered
                alignment: end
            }
            layout {
                sequence: 50
            }
            source {
                dataType: number
            }
        )

        column RESERVED_QTY (
            type: plainText
            heading {
                heading: Reserved
                alignment: end
            }
            layout {
                sequence: 60
            }
            source {
                dataType: number
            }
        )

        column AVAILABLE (
            type: plainText
            heading {
                heading: Available
                alignment: end
            }
            layout {
                sequence: 70
            }
            source {
                dataType: number
            }
        )

        column UNIT_PRICE (
            type: plainText
            heading {
                heading: Unit price
                alignment: end
            }
            layout {
                sequence: 80
            }
            source {
                dataType: number
            }
        )

        column VALUE_XAF (
            type: plainText
            heading {
                heading: Value (XAF)
                alignment: end
            }
            layout {
                sequence: 90
            }
            source {
                dataType: number
            }
        )

        column STOCK_STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
        )

        savedReport default-inventory (
            visibility: primaryDefault
            view {
                rowsPerPage: 25
            }
        )
    )
)