page 40 (
    name: Transfers
    alias: TRANSFERS
    title: Inter-Warehouse Transfers
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @regal-manager
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region transfer-list (
        name: Transfer pipeline
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select transfer_id,
                       transfer_number,
                       to_char(transfer_date, 'DD/MM/YYYY HH24:MI') as transfer_at,
                       source_warehouse,
                       target_warehouse,
                       status,
                       nb_lines,
                       total_requested_qty,
                       total_sent_qty,
                       total_received_qty,
                       days_in_process,
                       case
                         when days_in_process > 7  then '> 7 days'
                         when days_in_process > 3  then '> 3 days'
                         when days_in_process > 0  then 'normal'
                         else '-'
                       end as age_alerte
                  from app_api.v_transfer_pipeline
                 order by transfer_date desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }

        column TRANSFER_ID (
            type: plainText
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column TRANSFER_NUMBER (
            type: plainText
            heading {
                heading: Number
            }
            layout {
                sequence: 20
            }
            source {
                dataType: VARCHAR2
            }
        )

        column TRANSFER_AT (
            type: plainText
            heading {
                heading: Date
            }
            layout {
                sequence: 30
            }
            source {
                dataType: VARCHAR2
            }
        )

        column SOURCE_WAREHOUSE (
            type: plainText
            heading {
                heading: From
            }
            layout {
                sequence: 40
            }
            source {
                dataType: VARCHAR2
            }
        )

        column TARGET_WAREHOUSE (
            type: plainText
            heading {
                heading: To
            }
            layout {
                sequence: 50
            }
            source {
                dataType: VARCHAR2
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 60
            }
            source {
                dataType: VARCHAR2
            }
        )

        column NB_LINES (
            type: plainText
            heading {
                heading: Lines
                alignment: end
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
        )

        column TOTAL_REQUESTED_QTY (
            type: plainText
            heading {
                heading: Requested
                alignment: end
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
        )

        column TOTAL_SENT_QTY (
            type: plainText
            heading {
                heading: Sent
                alignment: end
            }
            layout {
                sequence: 90
            }
            source {
                dataType: NUMBER
            }
        )

        column TOTAL_RECEIVED_QTY (
            type: plainText
            heading {
                heading: Received
                alignment: end
            }
            layout {
                sequence: 100
            }
            source {
                dataType: NUMBER
            }
        )

        column DAYS_IN_PROCESS (
            type: plainText
            heading {
                heading: Days
                alignment: end
            }
            layout {
                sequence: 110
            }
            source {
                dataType: NUMBER
            }
        )

        column AGE_ALERTE (
            type: plainText
            heading {
                heading: Age alert
            }
            layout {
                sequence: 120
            }
            source {
                dataType: VARCHAR2
            }
        )

        savedReport default-transfers (
            visibility: primaryDefault
            view {
                rowsPerPage: 25
            }
        )
    )
)