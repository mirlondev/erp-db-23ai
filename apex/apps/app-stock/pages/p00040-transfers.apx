page 40 (
    name: 'Transfers'
    alias: TRANSFERS
    title: 'Pipeline Transferts Inter-Sites'
    security {
        authorizationScheme: @regal_manager
        pageAccessProtection: argumentsMustHaveChecksum
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }

    region breadcrumb (
        type: breadcrumb
        slot: breadcrumbBar
        template: @/title-bar
        templateOptions: t-BreadcrumbRegion--useBreadcrumbTitle
    )

    region transfer-kpi (
        type: staticContent
        name: 'KPI Transferts'
        slot: body
        seq: 10
        template: @/standard
        templateOptions: t-Region--noPadding t-Region--removeHeader js-removeLandmark
        
        pageItem P40_KPI_REQUESTED (
            type: displayOnly
            label: 'Demandés'
            source {
                type: plsqlExpression
                plsqlExpression: '''
                    to_char(nvl((select count(*) from app_inv.transfer_header where status='REQUESTED'),0),'FM9,999')
                '''
                used: always
            }
            layout {
                region: @transfer_kpi
                column: 1
            }
            appearance {
                template: @/optional-floating
                templateOptions: t-Form-fieldContainer--large
            }
        )

        pageItem P40_KPI_APPROVED (
            type: displayOnly
            label: 'Approuvés'
            source {
                type: plsqlExpression
                plsqlExpression: '''
                    to_char(nvl((select count(*) from app_inv.transfer_header where status='APPROVED'),0),'FM9,999')
                '''
                used: always
            }
            layout {
                region: @transfer_kpi
                column: 2
            }
            appearance {
                template: @/optional-floating
                templateOptions: t-Form-fieldContainer--large
            }
        )

        pageItem P40_KPI_PACKED (
            type: displayOnly
            label: 'En préparation'
            source {
                type: plsqlExpression
                plsqlExpression: '''
                    to_char(nvl((select count(*) from app_inv.transfer_header where status='PACKED'),0),'FM9,999')
                '''
                used: always
            }
            layout {
                region: @transfer_kpi
                column: 3
            }
            appearance {
                template: @/optional-floating
                templateOptions: t-Form-fieldContainer--large
            }
        )

        pageItem P40_KPI_TRANSIT (
            type: displayOnly
            label: 'En transit'
            source {
                type: plsqlExpression
                plsqlExpression: '''
                    to_char(nvl((select count(*) from app_inv.transfer_header where status='IN_TRANSIT'),0),'FM9,999')
                '''
                used: always
            }
            layout {
                region: @transfer_kpi
                column: 4
            }
            appearance {
                template: @/optional-floating
                templateOptions: t-Form-fieldContainer--large
            }
        )
    )

    region transfer-list (
        type: interactiveReport
        name: 'Pipeline transferts'
        slot: body
        seq: 20
        template: @/interactive-report
        templateOptions: t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
        source {
            type: sqlQuery
            sqlQuery: ```sql
                select transfer_id,
                       transfer_number,
                       to_char(transfer_date, 'DD/MM/YYYY HH24:MI') as transfer_at,
                       source_warehouse,
                       target_warehouse,
                       status,
                       case status
                         when 'DRAFT'      then '<span class="t-Badge t-Badge--neutral">DRAFT</span>'
                         when 'REQUESTED'  then '<span class="t-Badge t-Badge--info">DEMANDÉ</span>'
                         when 'APPROVED'   then '<span class="t-Badge t-Badge--success u-color-4">APPROUVÉ</span>'
                         when 'PACKED'     then '<span class="t-Badge t-Badge--warning">PRÉPARÉ</span>'
                         when 'IN_TRANSIT' then '<span class="t-Badge t-Badge--warning u-color-14">EN TRANSIT</span>'
                         when 'RECEIVED'   then '<span class="t-Badge t-Badge--success">REÇU</span>'
                         when 'CLOSED'     then '<span class="t-Badge t-Badge--success">CLÔTURÉ</span>'
                         when 'CANCELLED'  then '<span class="t-Badge t-Badge--danger">ANNULÉ</span>'
                         else '<span class="t-Badge t-Badge--neutral">' || status || '</span>'
                       end as status_badge,
                       nb_lines,
                       total_requested_qty,
                       total_sent_qty,
                       total_received_qty,
                       days_in_process,
                       case
                         when days_in_process > 7 then '<span class="t-Badge t-Badge--danger">&gt; 7 jours</span>'
                         when days_in_process > 3 then '<span class="t-Badge t-Badge--warning">&gt; 3 jours</span>'
                         when days_in_process > 0 then '<span class="t-Badge t-Badge--success">Normal</span>'
                         else '<span class="t-Badge t-Badge--neutral">—</span>'
                       end as age_badge
                  from app_api.v_transfer_pipeline
                 order by transfer_date desc
            ```
        }
        
        column TRANSFER_ID (
            type: plainText
            heading {
        heading: 'ID'
    }
            layout {
        seq: 10
    }
            source {
        dataType: NUMBER
    }
        )
        column TRANSFER_NUMBER (
            type: plainText
            heading {
        heading: 'Numéro'
    }
            layout {
        seq: 20
    }
            source {
        dataType: STRING
    }
        )
        column TRANSFER_AT (
            type: plainText
            heading {
        heading: 'Date'
    }
            layout {
        seq: 30
    }
            source {
        dataType: STRING
    }
        )
        column SOURCE_WAREHOUSE (
            type: plainText
            heading {
        heading: 'De'
    }
            layout {
        seq: 40
    }
            source {
        dataType: STRING
    }
        )
        column TARGET_WAREHOUSE (
            type: plainText
            heading {
        heading: 'Vers'
    }
            layout {
        seq: 50
    }
            source {
        dataType: STRING
    }
        )
        column STATUS (
            type: plainText
            heading {
        heading: 'Statut (raw)'
    }
            layout {
        seq: 55
    }
            source {
        dataType: STRING
    }
            appearance {
        hidden: true
    }
        )
        column STATUS_BADGE (
            type: htmlContent
            heading {
        heading: 'Statut'
    }
            layout {
        seq: 60
    }
            source {
        dataType: STRING
    }
        )
        column NB_LINES (
            type: plainText
            heading {
        heading: 'Lignes'
        alignment: end
    }
            layout {
        seq: 70
    }
            source {
        dataType: NUMBER
    }
        )
        column TOTAL_REQUESTED_QTY (
            type: plainText
            heading {
        heading: 'Demandé'
        alignment: end
    }
            layout {
        seq: 80
    }
            source {
        dataType: NUMBER
    }
        )
        column TOTAL_SENT_QTY (
            type: plainText
            heading {
        heading: 'Envoyé'
        alignment: end
    }
            layout {
        seq: 90
    }
            source {
        dataType: NUMBER
    }
        )
        column TOTAL_RECEIVED_QTY (
            type: plainText
            heading {
        heading: 'Reçu'
        alignment: end
    }
            layout {
        seq: 100
    }
            source {
        dataType: NUMBER
    }
        )
        column DAYS_IN_PROCESS (
            type: plainText
            heading {
        heading: 'Jours'
        alignment: end
    }
            layout {
        seq: 110
    }
            source {
        dataType: NUMBER
    }
        )
        column AGE_BADGE (
            type: htmlContent
            heading {
        heading: 'Ancienneté'
    }
            layout {
        seq: 120
    }
            source {
        dataType: STRING
    }
        )

        savedReport default-transfers (
            visibility: primaryDefault
            rowsPerPage: 25
        )
    )
)