page 30 (
    name: Stock Movements
    alias: MOVEMENTS
    title: 🔄 Mouvements de stock
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorization: @regal-vendeur
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region movement-filters (
        name: Filtres
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
    )

    pageItem P30_DATE_FROM (
        type: datePicker
        label {
            label: 📅 Du
        }
        layout {
            sequence: 10
            region: @movement-filters
            slot: regionBody
            column: 1
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 12
        }
        default {
            staticValue: TRUNC(SYSDATE) - 7
        }
    )

    pageItem P30_DATE_TO (
        type: datePicker
        label {
            label: Au
        }
        layout {
            sequence: 20
            region: @movement-filters
            slot: regionBody
            column: 2
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 12
        }
        default {
            staticValue: TRUNC(SYSDATE)
        }
    )

    pageItem P30_WAREHOUSE (
        type: selectList
        label {
            label: 🏢 Dépôt
        }
        layout {
            sequence: 30
            region: @movement-filters
            slot: regionBody
            column: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 16
        }
        listOfValues {
            sharedComponent: @WAREHOUSES
        }
        allowEmptyValue: true
        valueRequired: false
    )

    region movements-list (
        name: Mouvements détaillés
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Historique des mouvements basé sur inv_stock.last_in_at/last_out_at
                -- (table dédiée app_inv.stock_movement si existe, sinon vue dérivée)
                SELECT s.warehouse_code,
                       s.product_code,
                       p.product_name,
                       NVL(s.stock_qty, 0) AS current_stock,
                       TO_CHAR(s.last_in_at,  'DD/MM/YYYY HH24:MI') AS last_in,
                       TO_CHAR(s.last_out_at, 'DD/MM/YYYY HH24:MI') AS last_out,
                       ROUND(
                         (NVL(s.last_in_at, SYSDATE) - NVL(s.last_out_at, SYSDATE)) * 24
                       , 1) AS hours_since_last_move,
                       NVL(p.standard_price, 0) AS unit_cost
                  FROM app_inv.inv_stock s
                  JOIN app_product.product p ON p.product_code = s.product_code
                 WHERE (:P30_WAREHOUSE IS NULL OR s.warehouse_code = :P30_WAREHOUSE)
                   AND (
                        (:P30_DATE_FROM IS NULL OR s.last_in_at  >= :P30_DATE_FROM)
                     OR (:P30_DATE_FROM IS NULL OR s.last_out_at >= :P30_DATE_FROM)
                   )
                 ORDER BY GREATEST(NVL(s.last_in_at, DATE '1900-01-01'),
                                    NVL(s.last_out_at, DATE '1900-01-01')) DESC
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }
    )

    breadcrumb movements-bc (
        name: Movements
        entry (
            label: 🔄 Mouvements
            page: 30
        )
    )
)
