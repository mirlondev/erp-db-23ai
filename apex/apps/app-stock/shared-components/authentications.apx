authentication regal-auth (
    name: REGAL Authentication
    type: plsql
    settings {
        plsqlCode: return app_sys.pkg_apex_auth.authenticate(:APP_USER, :APP_PASSWORD);
    }
    cookie {
        name: &WORKSPACE_COOKIE.
    }
    session {
        sharing: workspace
    }
    security {
        sessionTimeout: 28800
        maximumSessions: 25
    }
    login {
        procedure: null
    }
    logout {
        procedure: null
    }
    postLogout {
        procedure: null
    }
)
