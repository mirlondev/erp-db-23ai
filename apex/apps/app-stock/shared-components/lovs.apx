lov boolean (
    name: BOOLEAN
    source {
        location: staticValues
    }

    entry false (
        sequence: 2
        display: No
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Yes
        return: TRUE
    )

)

lov WAREHOUSES (
    name: WAREHOUSES
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select warehouse_code as d,
                   warehouse_code as r
              from app_inv.inv_stock
             group by warehouse_code
             order by warehouse_code
            ```
    }
    columnMapping {
        display: d
        return: r
    }
)

