list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry stcoc (
        label: Stock (legacy)
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry inventory (
        label: Inventory
        icon {
            imageIconCssClasses: fa-warehouse
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: 10
        }
        link {
            target: {
                page: 10
            }
        }
    )

    entry low-stock (
        label: Low Stock
        icon {
            imageIconCssClasses: fa-exclamation-triangle
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: 20
        }
        link {
            target: {
                page: 20
            }
        }
    )

    entry movements (
        label: Movements
        icon {
            imageIconCssClasses: fa-exchange-alt
        }
        layout {
            sequence: 50
        }
        isCurrent {
            type: pages
            pages: 30
        }
        link {
            target: {
                page: 30
            }
        }
    )

    entry transfers (
        label: Transfers
        icon {
            imageIconCssClasses: fa-truck-loading
        }
        layout {
            sequence: 60
        }
        isCurrent {
            type: pages
            pages: 40
        }
        link {
            target: {
                page: 40
            }
        }
    )

    entry bulk-import (
        label: Bulk Import
        icon {
            imageIconCssClasses: fa-file-csv
        }
        layout {
            sequence: 70
        }
        isCurrent {
            type: pages
            pages: 50
        }
        link {
            target: {
                page: 50
            }
        }
    )

)

