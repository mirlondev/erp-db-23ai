CREATE FORCE VIEW "CAISSE"."GCVREL_TIE" ("CODETA", "DATPCE", "NUMPCE", "TYPE", "TYPPCE", "DATECH", "CODTIE", "NOMTIE", "MT_CREDIT", "MT_DEBIT") AS SELECT  e.CODETA, e.DATFAC Datpce, e.NUMFAC Numpce, 'F' Type, e.CODTBRD Typpce, e.DATECH,
        e.CODTIE, e.NOMTIE,
        0 Mt_credit, SUM(e.MTTC) Mt_debit
FROM GCBRDE e
WHERE e.NUMFAC IS NOT NULL and e.ETAT != 'A'
GROUP BY e.CODETA, e.DATFAC, e.NUMFAC, e.CODTBRD, e.DATECH,
        e.CODTIE, e.NOMTIE
UNION
SELECT  e.CODETA, e.DATRGL, e.NUMRGL, 'R', e.CODTRGL Typpce, e.DATRGL,
        e.CODTIE, null,
        Mtrgl Mt_credit, 0
FROM GCRGLE e
WHERE e.ETAT != 'A'

 
